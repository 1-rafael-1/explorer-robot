{
  "lsp": {
    "crates-lsp": {
      "initialization_options": {
        // crates-lsp only resolves crates.io names, so the workspace's path dependencies
        // (remote-protocol, bridge-net, remote-link) are always reported as "Unknown crate".
        // Keep its version completion and inlay hints, drop the false-positive diagnostics.
        "diagnostics": false
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "allTargets": false
        },
        "check": {
          "command": "clippy"
        },
        "linkedProjects": [
          "Cargo.toml",
          "bridge-firmware/Cargo.toml",
          "remote/Cargo.toml"
        ]
      }
    }
  },
  "languages": {
    "Rust": {
      "format_on_save": "on",
      "formatter": "auto",
      "inlay_hints": {
        "enabled": true
      }
    }
  }
}
